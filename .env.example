# ─── Copy to .env and fill in real values ─────────────────────────────────────
# NEVER commit your real .env to git.

# OpenAI (REQUIRED)
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-32-char-random-string!!

# Database (used by Docker Compose — change only if you override ports)
DATABASE_URL=postgresql+asyncpg://panscience:panscience@postgres:5432/panscience
DATABASE_URL_SYNC=postgresql://panscience:panscience@postgres:5432/panscience

# Redis (used by Docker Compose)
REDIS_URL=redis://redis:6379/0

# Optional overrides
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MAX_FILE_SIZE_MB=500
RATE_LIMIT_PER_MINUTE=20
ENVIRONMENT=development
DEBUG=true
